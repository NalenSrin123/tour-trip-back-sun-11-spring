									"pm.test(\"Requires OTP is true\", function () {",
									"    pm.expect(jsonData.requiresOtp).to.eql(true);",
									"});",
									"",
									"if (jsonData.otpCode) {",
									"    pm.environment.set(\"otpCode\", jsonData.otpCode);",
									"    console.log(\"Saved OTP Code to environment: \" + jsonData.otpCode);",
